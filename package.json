{
  "name": "diablo-build-companion",
  "productName": "Sanctum",
  "version": "0.2.1",
  "description": "Local-first Diablo IV build companion, screenshot advisor and desktop overlay",
  "author": "Lucas Dallacqua",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-host/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "host": "node scripts/build-host.mjs",
    "start": "pnpm build && electron .",
    "build": "tsc --noEmit && vite build && pnpm host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:check": "node scripts/check-assets.mjs",
    "ocr:prepare": "node scripts/prepare-ocr.mjs",
    "package:win": "pnpm build && pnpm ocr:prepare && electron-builder --win nsis portable --x64 --publish never"
  },
  "build": {
    "appId": "io.ldallacqua.sanctum",
    "productName": "Sanctum",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "dist-host/main.cjs",
      "dist-host/main.cjs.map",
      "dist-host/preload.cjs",
      "dist-host/preload.cjs.map",
      "dist-host/extractor.cjs",
      "dist-host/extractor.cjs.map",
      "resources/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**",
      "dist-host/extractor.cjs"
    ],
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "ocr"
      },
      {
        "from": "resources/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/extraction-notices.txt",
        "to": "extraction-notices.txt"
      },
      {
        "from": "LICENSE",
        "to": "PROJECT_LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Sanctum-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Sanctum-${version}-${arch}-Portable.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
